# The built-in song needs no MIDI fixture or game audio.
spawn player Music admin=1
say Music /jukebox demo
tick 1
expect log "JUKEBOX_SOUND tick=0 at=0 ch=1 note=60 sound=29 pitch=0.375"
expect log "JUKEBOX_SOUND tick=0 at=0 ch=10 note=36 sound=21 pitch=0.250000"
tick 15
expect log "JUKEBOX_SOUND tick=0 at=15 ch=1 note=64 sound=29 pitch=0.472"
tick 15
expect log "JUKEBOX_SOUND tick=0 at=30 ch=1 note=67 sound=29 pitch=0.562"
expect log "JUKEBOX_SOUND tick=0 at=30 ch=10 note=42 sound=21 pitch=2.000000"
tick 15
expect log "JUKEBOX_SOUND tick=0 at=45 ch=1 note=72 sound=29 pitch=0.750"
expect count 6 "JUKEBOX_SOUND "
expect log "Finished: played=6 dropped_notes=0 dropped_calls=0 moved=0 failed=0."
spawn player Guest admin=0
say Guest /jukebox demo
tick 1
expect log "Plugin command permission denied: jukebox"
expect count 6 "JUKEBOX_SOUND "
expect no-failure
